# Exclude research / training / non-runtime material from the deployed bundle.
#
# Production inference is the dependency-free Node scorer (Phase 3-5). The
# deployed runtime needs ONLY: api/, public/, node/scorer.js, and
# models/deployed/tabular_{model,pipeline,meta}.json.
# Everything below is research/tooling and must not be bundled.

# --- Datasets & satellite imagery (absent from fresh clones anyway) ---
data/
images/

# --- Notebooks ---
notebooks/

# --- Preprocessed research caches (embeddings / pickles) ---
preprocessed/

# --- Vision / research model checkpoints (NOT production inference) ---
models/vision/
models/deployed/*.pt

# --- Python numpy array reference artifacts (Node scorer uses .json) ---
models/deployed/*.joblib

# --- Non-deployed outputs ---
predictions/
scripts/
tests/
reports/figures/
archive/

# --- Research-only dependency file ---
requirements-research.txt

# --- Secrets ---
.env

# --- Runtime/interpreter junk ---
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/